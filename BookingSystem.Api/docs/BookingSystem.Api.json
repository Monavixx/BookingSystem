              "string"
            ],
            "format": "int32"
          }
        }
      },
      "BookingStatus": {
        "type": "integer"
      },
      "ContactDto": {
        "required": [
          "phoneNumber",
          "email"
        ],
        "type": "object",
        "properties": {
          "phoneNumber": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CreateBookingRequest": {
        "required": [
          "guestCount",
          "restaurantId",
          "tableNumber",
          "scheduledAt"
        ],
        "type": "object",
        "properties": {
          "guestCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "restaurantId": {
            "type": "string",
            "format": "uuid"
          },
          "tableNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateRestaurantCommand": {
        "required": [
          "address",
          "contact",
          "description",
          "imageUrl"
        ],
        "type": "object",
        "properties": {
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "contact": {
            "$ref": "#/components/schemas/ContactDto"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DayOfWeek": {
        "type": "integer"
      },
      "DayOfWeekScheduleRequest": {
        "required": [
          "dayOfWeek",
          "openingTime",
          "closingTime",
          "isClosed"
        ],
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DayOfWeek"
              }
            ]
          },
          "openingTime": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "closingTime": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "isClosed": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "FilterMode": {
        "type": "integer"
      },
