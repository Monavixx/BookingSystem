      },
      "AddTableRequestBody": {
        "required": [
          "tableNumber",
          "capacity"
        ],
        "type": "object",
        "properties": {
          "tableNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "capacity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
